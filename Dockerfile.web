# Dockerfile untuk Web Admin GUI.
# Share base image dengan bot (libreoffice + python deps) agar re-generate PDF
# dari web tetap bisa berjalan tanpa image kedua.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    TZ=Asia/Jakarta \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    curl \
    libreoffice-writer \
    fonts-liberation \
    fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

# Hanya expose port web (8080) — bot tidak hidup di container ini.
EXPOSE 8080

CMD ["python", "-m", "src.web.app"]